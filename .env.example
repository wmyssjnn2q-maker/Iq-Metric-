# Skopiuj do .env.local i uzupełnij wartości:
#   cp .env.example .env.local

# Wymagane do wysyłki e-mail (https://resend.com/api-keys)
# Lokalnie: .env.local  |  Produkcja Vercel: Settings → Environment Variables → Production → Redeploy
RESEND_API_KEY=re_xxxxxxxx

# Opcjonalnie — nadawca (domena musi być zweryfikowana w Resend)
# Bez tego używany jest onboarding@resend.dev (tylko na Twój adres testowy w Resend)
RESEND_FROM_EMAIL=noreply@brainmediq.com
RESEND_FROM_NAME=brainmediq

# Opcjonalnie — analiza AI w raporcie
GEMINI_API_KEY=

# Port API lokalnego (domyślnie 3002)
API_PORT=3002

# Opcjonalne — podpis wyniku IQ (HMAC). Bez tego wynik i tak jest liczony na serwerze.
# Lokalnie: .env.local  |  Vercel: Settings → Environment Variables → Production → Redeploy
SCORE_SECRET=

# --- Stripe (płatności) ---
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Webhook: Developers → Webhooks → endpoint https://brainmediq.com/api/stripe-webhook
# Zdarzenie: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Opcjonalnie — podpis tokena zakupu (min. 16 znaków). Bez tego używany jest SCORE_SECRET.
PAYMENT_SIGNING_SECRET=
# URL aplikacji (produkcja). Vercel ustawia VERCEL_URL automatycznie.
APP_URL=https://brainmediq.com

# Stripe Price ID (opcjonalne — bez nich używane są kwoty z lib/paymentProducts.ts)
STRIPE_PRICE_IQ_STANDARD=price_xxxxxxxx
STRIPE_PRICE_IQ_PRO=price_xxxxxxxx
STRIPE_PRICE_IQ_MAX=price_xxxxxxxx
STRIPE_PRICE_OSOBOWOSC=price_xxxxxxxx
STRIPE_PRICE_PAMIEC=price_xxxxxxxx
STRIPE_PRICE_KONCENTRACJA=price_xxxxxxxx
STRIPE_PRICE_REAKCJA=price_xxxxxxxx
STRIPE_PRICE_ALZHEIMER=price_xxxxxxxx
STRIPE_PRICE_ADHD=price_xxxxxxxx
