# Skopiuj do .env.local i uzupełnij wartości:
#   cp .env.example .env.local

# Wymagane do wysyłki e-mail (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Opcjonalnie — nadawca (domena musi być zweryfikowana w Resend)
# Bez tego używany jest onboarding@resend.dev (tylko na Twój adres testowy w Resend)
RESEND_FROM_EMAIL=noreply@brainmediq.com
RESEND_FROM_NAME=brainmediq

# Opcjonalnie — analiza AI w raporcie
GEMINI_API_KEY=

# Port API lokalnego (domyślnie 3002)
API_PORT=3002

# Wymagane do oceny IQ po stronie serwera (min. 16 znaków; losowy ciąg)
SCORE_SECRET=zmien_na_dlugi_losowy_ciag_znakow
