{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/stripe-webhook.ts": {
      "maxDuration": 30,
      "includeFiles": "lib/**"
    },
    "api/create-checkout-session.ts": {
      "includeFiles": "lib/**"
    },
    "api/verify-purchase.ts": {
      "includeFiles": "lib/**"
    }
  }
}
